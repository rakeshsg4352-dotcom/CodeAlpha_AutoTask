# ==============================================================================
# AutoTask - Environment Configuration Template
# Copy this file to '.env' and adjust the values according to your local setup.
# ==============================================================================

# Django Secret Key (Keep this secret in production!)
SECRET_KEY=django-insecure-autotask-academic-project-key-replace-with-secure-key-2026

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Configuration (XAMPP Default: host=127.0.0.1, port=3306, user=root, password='')
DB_NAME=autotask_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Security & Workspace Configuration (Leave blank to use default media/workspace directory)
APPROVED_WORKSPACE=
